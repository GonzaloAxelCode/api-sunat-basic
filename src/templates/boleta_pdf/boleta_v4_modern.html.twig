<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        {% include 'assets/style.css' %}
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #1f2d2b; font-size: 12px; }
        .card { background: #f4faf9; border-radius: 8px; padding: 12px 16px; margin-bottom: 12px; }
        .card-title { color: #0e7c66; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 6px; }
        .chip { display: inline-block; background: #0e7c66; color: #fff; border-radius: 14px; padding: 4px 14px; font-size: 13px; font-weight: 600; }
        .doc-title { font-size: 22px; font-weight: 700; color: #0e7c66; }
        table.items { width: 100%; border-collapse: separate; border-spacing: 0 4px; }
        table.items th { text-align: center; font-size: 10px; color: #0e7c66; padding: 6px; }
        table.items td { background: #f4faf9; padding: 8px; font-size: 11px; }
        table.items td:first-child { border-radius: 6px 0 0 6px; }
        table.items td:last-child { border-radius: 0 6px 6px 0; }
        table.totals td { padding: 4px 8px; font-size: 12px; }
        table.totals tr.grand td { font-size: 15px; font-weight: 700; color: #0e7c66; }
        .totals-box { background: #0e7c66; color: #fff; border-radius: 8px; padding: 10px 16px; }
        .totals-box table.totals tr.grand td { color: #fff; }
        .totals-box table.totals td { color: #eafaf6; }
        .sub-title { font-weight: 600; font-size: 10px; color: #0e7c66; margin: 8px 0 4px 0; }
    </style>
</head>
<body class="white-bg">
{% set cp = doc.company %}
{% set isInvoice = doc.tipoDoc in ['01', '03'] %}
{% set isNota = doc.tipoDoc in ['07', '08'] %}
{% set isAnticipo = doc.totalAnticipos is defined and doc.totalAnticipos > 0 %}
{% set name = doc.tipoDoc|catalog('01') %}
<table width="100%" cellpadding="0" cellspacing="0">
    <tbody>
        <tr>
            <td style="padding:24px;">

                <table width="100%" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td width="20%"><img src="{{ params.system.logo_url ?: (params.system.logo|image_b64) }}" height="55" style="object-fit:contain;" border="0"></td>
                            <td width="45%">
                                <span class="doc-title">{{ name }}</span><br>
                                <span style="font-size:11px; color:#5b6b68;">R.U.C.: {{ cp.ruc }}</span>
                            </td>
                            <td width="35%" align="right"><span class="chip">{{ doc.serie }}-{{ doc.correlativo }}</span></td>
                        </tr>
                    </tbody>
                </table>

                <br>
                <div class="card">
                    <div class="card-title">Emisor</div>
                    <strong>{{ cp.nombreComercial }}</strong><br>
                    {{ cp.address.direccion }}<br>
                    {{ params.user.header|raw }}
                </div>

                {% set cl = doc.client %}
                <div class="card">
                    <div class="card-title">Receptor</div>
                    <table width="100%" cellpadding="3" cellspacing="0">
                        <tbody>
                            <tr>
                                <td width="60%"><strong>Razón Social:</strong> {{ cl.rznSocial }}</td>
                                <td width="40%"><strong>{{ cl.tipoDoc|catalog('06') }}:</strong> {{ cl.numDoc }}</td>
                            </tr>
                            <tr>
                                <td width="60%">
                                    <strong>Fecha Emisión:</strong> {{ doc.fechaEmision|date('d/m/Y') }}
                                    {% if doc.fechaEmision|date('H:i:s') != '00:00:00' %} {{ doc.fechaEmision|date('H:i:s') }} {% endif %}
                                    {% if doc.fecVencimiento is defined and doc.fecVencimiento %}
                                        <br><strong>Fecha Vencimiento:</strong> {{ doc.fecVencimiento|date('d/m/Y') }}
                                    {% endif %}
                                </td>
                                <td width="40%"><strong>Dirección:</strong> {% if cl.address %}{{ cl.address.direccion }}{% endif %}</td>
                            </tr>
                            {% if isNota %}
                            <tr>
                                <td width="60%"><strong>Tipo Doc. Ref.:</strong> {{ doc.tipDocAfectado|catalog('01') }}</td>
                                <td width="40%"><strong>Documento Ref.:</strong> {{ doc.numDocfectado }}</td>
                            </tr>
                            {% endif %}
                            <tr>
                                <td width="60%"><strong>Tipo Moneda:</strong> {{ doc.tipoMoneda|catalog('021') }}</td>
                                <td width="40%">{% if doc.compra is defined and doc.compra %}<strong>O/C:</strong> {{ doc.compra }}{% endif %}</td>
                            </tr>
                            {% if doc.guias %}
                            <tr>
                                <td colspan="2"><strong>Guías:</strong> {% for guia in doc.guias %}{{ guia.nroDoc }}&nbsp;&nbsp;{% endfor %}</td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                {% set moneda = doc.tipoMoneda|catalog('02') %}
                <table class="items" cellpadding="0" cellspacing="0">
                    <thead>
                        <tr><th>Cantidad</th><th>Código</th><th>Descripción</th><th>Valor Unitario</th><th>Valor Total</th></tr>
                    </thead>
                    <tbody>
                        {% for det in doc.details %}
                        <tr>
                            <td align="center">{{ det.cantidad|n_format }} {{ det.unidad }}</td>
                            <td align="center">{{ det.codProducto }}</td>
                            <td>{{ det.descripcion }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorUnitario|n_format }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorVenta|n_format }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px;">
                    <tbody>
                        <tr>
                            <td width="55%" valign="top">
                                <div class="card">
                                    <div class="card-title">Información Adicional</div>
                                    <div style="font-size:10px;">
                                        <strong>Son:</strong> {{ legend(doc.legends, '1000') }}<br>
                                        {% if isInvoice and doc.detraccion %}
                                        <strong>Tipo de Detracción:</strong> {{ doc.detraccion.codBienDetraccion }} - {{ doc.detraccion.codBienDetraccion|catalog('54') }}<br>
                                        <strong>Medio de Pago:</strong> {{ doc.detraccion.codMedioPago }} - {{ doc.detraccion.codMedioPago|catalog('59') }}<br>
                                        <strong>N&deg; Cta. Banco Nac:</strong> {{ doc.detraccion.ctaBanco }}<br>
                                        {% endif %}
                                        {% if isNota %}
                                        <strong>Motivo de Emisión:</strong> {{ doc.desMotivo }}<br>
                                        {% endif %}
                                        {% if params.user.extras is defined %}
                                            {% for item in params.user.extras %}
                                            <strong>{{ item.name|upper }}:</strong> {{ item.value }}<br>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                    {% if isAnticipo %}
                                    <div class="sub-title">Anticipo</div>
                                    <table width="100%" cellpadding="3" cellspacing="0" style="font-size:10px;">
                                        <tbody>
                                            <tr><td width="30%"><b>Nro. Doc.</b></td><td width="70%"><b>Total</b></td></tr>
                                            {% for atp in doc.anticipos %}
                                            <tr><td>{{ atp.nroDocRel }}</td><td>{{ moneda }} {{ atp.total|n_format }}</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                    {% endif %}
                                    {% if doc.cuotas %}
                                    <div class="sub-title">Cuotas</div>
                                    <table width="100%" cellpadding="3" cellspacing="0" style="font-size:10px;">
                                        <tbody>
                                            <tr><td width="30%"><b>Monto</b></td><td width="70%"><b>Fecha Pago</b></td></tr>
                                            {% for cuota in doc.cuotas %}
                                            <tr><td>{{ moneda }} {{ cuota.monto|n_format }}</td><td>{{ cuota.fechaPago|date('d/m/Y') }}</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                    {% endif %}
                                </div>
                            </td>
                            <td width="45%" valign="top" style="padding-left:12px;">
                                <div class="totals-box">
                                    <table width="100%" class="totals" cellpadding="0" cellspacing="0">
                                        <tbody>
                                            {% if isAnticipo %}<tr><td align="right">Total Anticipo:</td><td align="right">{{ moneda }} {{ doc.totalAnticipos|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOperGravadas %}<tr><td align="right">Op. Gravadas:</td><td align="right">{{ moneda }} {{ doc.mtoOperGravadas|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOperInafectas %}<tr><td align="right">Op. Inafectas:</td><td align="right">{{ moneda }} {{ doc.mtoOperInafectas|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOperExoneradas %}<tr><td align="right">Op. Exoneradas:</td><td align="right">{{ moneda }} {{ doc.mtoOperExoneradas|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOperGratuitas %}<tr><td align="right">Op. Gratuitas:</td><td align="right">{{ moneda }} {{ doc.mtoOperGratuitas|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOperExportacion %}<tr><td align="right">Op. Exportación:</td><td align="right">{{ moneda }} {{ doc.mtoOperExportacion|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoBaseIvap %}<tr><td align="right">Base IVAP:</td><td align="right">{{ moneda }} {{ doc.mtoBaseIvap|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoIGVGratuitas %}<tr><td align="right">IGV Gratuito:</td><td align="right">{{ moneda }} {{ doc.mtoIGVGratuitas|n_format }}</td></tr>{% endif %}
                                            <tr><td align="right">I.G.V.{% if params.user.numIGV is defined %} {{ params.user.numIGV }}%{% endif %}:</td><td align="right">{{ moneda }} {{ doc.mtoIGV|n_format }}</td></tr>
                                            {% if doc.mtoIvap %}<tr><td align="right">IVAP:</td><td align="right">{{ moneda }} {{ doc.mtoIvap|n_format }}</td></tr>{% endif %}
                                            {% if doc.icbper %}<tr><td align="right">I.C.B.P.E.R.:</td><td align="right">{{ moneda }} {{ doc.icbper|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoISC %}<tr><td align="right">I.S.C.:</td><td align="right">{{ moneda }} {{ doc.mtoISC|n_format }}</td></tr>{% endif %}
                                            {% if doc.sumOtrosCargos %}<tr><td align="right">Otros Cargos:</td><td align="right">{{ moneda }} {{ doc.sumOtrosCargos|n_format }}</td></tr>{% endif %}
                                            {% if doc.mtoOtrosTributos %}<tr><td align="right">Otros Tributos:</td><td align="right">{{ moneda }} {{ doc.mtoOtrosTributos|n_format }}</td></tr>{% endif %}
                                            {% if doc.redondeo %}<tr><td align="right">Redondeo:</td><td align="right">{{ moneda }} {{ doc.redondeo|n_format }}</td></tr>{% endif %}
                                            <tr class="grand"><td align="right">Precio Venta:</td><td align="right"><span id="ride-importeTotal">{{ moneda }} {{ doc.mtoImpVenta|n_format }}</span></td></tr>
                                            {% if doc.perception and doc.perception.mto %}
                                                {% set perc = doc.perception %}
                                                {% set soles = 'PEN'|catalog('02') %}
                                                <tr><td align="right">Percepción:</td><td align="right">{{ soles }} {{ perc.mto|n_format }}</td></tr>
                                                <tr class="grand"><td align="right">Total a Pagar:</td><td align="right">{{ soles }} {{ perc.mtoTotal|n_format }}</td></tr>
                                            {% endif %}
                                            {% if isInvoice and doc.detraccion %}
                                            <tr><td align="right">Detracción ({{ doc.detraccion.percent }}%):</td><td align="right">{{ moneda }} {{ doc.detraccion.mount|n_format }}</td></tr>
                                            {% endif %}
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                {% if max_items is defined and doc.details|length > max_items %}
                    <div style="page-break-after:always;"></div>
                {% endif %}

                <br>
                <table width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #d7e6e3; padding-top:10px;">
                    <tbody>
                        <tr>
                            <td width="85%" style="font-size:10px; color:#5b6b68;">
                                {% if params.user.footer is defined %}{{ params.user.footer|raw }}{% endif %}
                                {% if params.system.hash is defined and params.system.hash %}<br><strong>Resumen:</strong> {{ params.system.hash }}{% endif %}
                                <br>Representación Impresa de la {{ name }} ELECTRÓNICA.
                            </td>
                            <td width="15%" align="right"><img src="{{ qrCode(doc)|image_b64('svg+xml') }}" alt="Qr Image" width="75"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
</body>
</html>
