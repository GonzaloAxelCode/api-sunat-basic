<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        {% include 'assets/style.css' %}
        body { font-family: 'Courier New', Consolas, monospace; color: #000; font-size: 10px; }
        table { border-collapse: collapse; }
        .box { border: 1px solid #000; }
        .box td { border-bottom: 1px solid #000; padding: 3px 5px; }
        .box tr:last-child td { border-bottom: none; }
        .doc-title { font-size: 16px; font-weight: bold; letter-spacing: 1px; }
        table.items th { border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 4px; font-size: 9px; text-align: center; }
        table.items td { border-bottom: 1px dotted #999; padding: 4px; font-size: 9px; }
        table.totals td { padding: 2px 5px; font-size: 10px; }
        table.totals tr.grand td { font-size: 12px; font-weight: bold; border-top: 1px solid #000; padding-top: 4px; }
    </style>
</head>
<body class="white-bg">
{% set cp = doc.company %}
{% set isInvoice = doc.tipoDoc == '01' %}
{% set isNota = doc.tipoDoc in ['07', '08'] %}
{% set name = 'FACTURA' %}
<table width="100%" cellpadding="0" cellspacing="0">
    <tbody>
        <tr>
            <td style="padding:18px;">

                <table width="100%" class="box" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td width="20%" style="border-right:1px solid #000;"><img src="{{ params.system.logo_url ?: (params.system.logo|image_b64) }}" height="45" border="0"></td>
                            <td width="45%" style="border-right:1px solid #000;">
                                <strong>{{ cp.nombreComercial }}</strong><br>
                                {{ cp.razonSocial }}<br>
                                RUC: {{ cp.ruc }}<br>
                                {{ cp.address.direccion }}<br>
                                {{ params.user.header|raw }}
                            </td>
                            <td width="35%" align="center">
                                <span class="doc-title">{{ name }}<br>ELECTRONICA</span><br><br>
                                <strong>{{ doc.serie }}-{{ doc.correlativo }}</strong>
                            </td>
                        </tr>
                    </tbody>
                </table>

                {% set cl = doc.client %}
                <table width="100%" class="box" cellpadding="0" cellspacing="0" style="border-top:none;">
                    <tbody>
                        <tr>
                            <td width="60%">RAZON SOCIAL: {{ cl.rznSocial }}</td>
                            <td width="40%">{{ cl.tipoDoc|catalog('06') }}: {{ cl.numDoc }}</td>
                        </tr>
                        <tr>
                            <td width="60%">
                                FECHA EMISION: {{ doc.fechaEmision|date('d/m/Y') }}
                                {% if doc.fechaEmision|date('H:i:s') != '00:00:00' %} {{ doc.fechaEmision|date('H:i:s') }} {% endif %}
                                {% if doc.fecVencimiento is defined and doc.fecVencimiento %}
                                    | VENCIMIENTO: {{ doc.fecVencimiento|date('d/m/Y') }}
                                {% endif %}
                            </td>
                            <td width="40%">DIRECCION: {% if cl.address %}{{ cl.address.direccion }}{% endif %}</td>
                        </tr>
                        <tr>
                            <td width="60%">MONEDA: {{ doc.tipoMoneda|catalog('021') }}</td>
                            <td width="40%">{% if doc.compra is defined and doc.compra %}O/C: {{ doc.compra }}{% endif %}</td>
                        </tr>
                        {% if doc.guias %}
                        <tr>
                            <td colspan="2">GUIAS: {% for guia in doc.guias %}{{ guia.nroDoc }} {% endfor %}</td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>

                {% set moneda = doc.tipoMoneda|catalog('02') %}
                <table width="100%" class="items" cellpadding="0" cellspacing="0">
                    <thead>
                        <tr><th>CANT.</th><th>CODIGO</th><th>DESCRIPCION</th><th>V.UNIT.</th><th>V.TOTAL</th></tr>
                    </thead>
                    <tbody>
                        {% for det in doc.details %}
                        <tr>
                            <td align="center">{{ det.cantidad|n_format }} {{ det.unidad }}</td>
                            <td align="center">{{ det.codProducto }}</td>
                            <td>{{ det.descripcion }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorUnitario|n_format }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorVenta|n_format }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:6px;">
                    <tbody>
                        <tr>
                            <td width="60%" valign="top" style="font-size:8px; padding-right:8px;">
                                LEYENDA: {{ legend(doc.legends, '1000') }}<br>
                                {% if isInvoice and doc.detraccion %}
                                TIPO DE DETRACCION: {{ doc.detraccion.codBienDetraccion }} - {{ doc.detraccion.codBienDetraccion|catalog('54') }}<br>
                                MEDIO DE PAGO: {{ doc.detraccion.codMedioPago }} - {{ doc.detraccion.codMedioPago|catalog('59') }}<br>
                                N CTA. BANCO NAC: {{ doc.detraccion.ctaBanco }}<br>
                                {% endif %}
                                {% if isNota %}
                                MOTIVO DE EMISION: {{ doc.desMotivo }}<br>
                                {% endif %}
                                {% if params.user.extras is defined %}
                                    {% for item in params.user.extras %}
                                    {{ item.name|upper }}: {{ item.value }}<br>
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td width="40%" valign="top">
                                <table width="100%" class="totals" cellpadding="0" cellspacing="0">
                                    <tbody>
                                        {% if doc.mtoOperGravadas %}
                                        <tr><td align="right">OP. GRAVADAS:</td><td align="right">{{ moneda }} {{ doc.mtoOperGravadas|n_format }}</td></tr>
                                        {% endif %}
                                        {% if doc.mtoOperExoneradas %}
                                        <tr><td align="right">OP. EXONERADAS:</td><td align="right">{{ moneda }} {{ doc.mtoOperExoneradas|n_format }}</td></tr>
                                        {% endif %}
                                        <tr><td align="right">I.G.V.{% if params.user.numIGV is defined %} {{ params.user.numIGV }}%{% endif %}:</td><td align="right">{{ moneda }} {{ doc.mtoIGV|n_format }}</td></tr>
                                        <tr class="grand"><td align="right">PRECIO VENTA:</td><td align="right"><span id="ride-importeTotal">{{ moneda }} {{ doc.mtoImpVenta|n_format }}</span></td></tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #000; margin-top:8px; padding-top:6px;">
                    <tbody>
                        <tr>
                            <td width="85%" style="font-size:8px;">
                                {% if params.user.footer is defined %}{{ params.user.footer|raw }}{% endif %}
                                {% if params.system.hash is defined and params.system.hash %}<br>RESUMEN: {{ params.system.hash }}{% endif %}
                                <br>REPRESENTACION IMPRESA DE LA FACTURA ELECTRONICA.
                            </td>
                            <td width="15%" align="right"><img src="{{ qrCode(doc)|image_b64('svg+xml') }}" alt="Qr Image" width="65"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
</body>
</html>
