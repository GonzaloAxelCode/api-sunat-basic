<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        {% include 'assets/style.css' %}
        body { font-family: Arial, Helvetica, sans-serif; color: #1c2b39; font-size: 12px; }
        .header-band { background: #10365e; color: #ffffff; padding: 14px 20px; }
        .header-band .doc-type { font-size: 22px; letter-spacing: 2px; font-weight: bold; }
        .header-band .doc-sub { font-size: 12px; opacity: .85; }
        .header-band .doc-num { font-size: 20px; font-weight: bold; text-align: right; }
        .panel { border: 1px solid #c9d4de; border-radius: 4px; padding: 10px 14px; margin-bottom: 12px; }
        .panel-title { color: #10365e; font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; border-bottom: 1px solid #c9d4de; padding-bottom: 4px; margin-bottom: 6px; }
        table.items { width: 100%; border-collapse: collapse; }
        table.items th { background: #10365e; color: #fff; font-size: 10px; padding: 8px; text-align: center; }
        table.items td { padding: 6px 8px; font-size: 11px; border-bottom: 1px solid #e3e8ec; }
        table.totals td { padding: 4px 8px; font-size: 12px; }
        table.totals tr.grand td { font-size: 15px; font-weight: bold; color: #10365e; border-top: 2px solid #10365e; padding-top: 6px; }
        .footer-note { font-size: 10px; color: #5a6b78; border-top: 1px solid #c9d4de; padding-top: 8px; margin-top: 16px; }
    </style>
</head>
<body class="white-bg">
{% set cp = doc.company %}
{% set isInvoice = doc.tipoDoc == '01' %}
{% set isNota = doc.tipoDoc in ['07', '08'] %}
{% set name = 'FACTURA' %}
<table width="100%" cellpadding="0" cellspacing="0">
    <tbody>
        <tr>
            <td style="padding:24px;">

                <table width="100%" class="header-band" cellpadding="0" cellspacing="0">
                    <tbody>
                        <tr>
                            <td width="20%"><img src="{{ params.system.logo_url ?: (params.system.logo|image_b64) }}" height="60" style="max-width:120px;" border="0"></td>
                            <td width="45%">
                                <span class="doc-type">{{ name }} ELECTRÓNICA</span><br>
                                <span class="doc-sub">R.U.C.: {{ cp.ruc }}</span>
                            </td>
                            <td width="35%" class="doc-num">{{ doc.serie }}-{{ doc.correlativo }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="panel" style="margin-top:14px;">
                    <div class="panel-title">Emisor</div>
                    <strong>{{ cp.nombreComercial }}</strong><br>
                    <strong>Razón Social:</strong> {{ cp.razonSocial }}<br>
                    <strong>Dirección:</strong> {{ cp.address.direccion }}<br>
                    {{ params.user.header|raw }}
                </div>

                {% set cl = doc.client %}
                <div class="panel">
                    <div class="panel-title">Receptor</div>
                    <table width="100%" cellpadding="3" cellspacing="0">
                        <tbody>
                            <tr>
                                <td width="60%"><strong>Razón Social:</strong> {{ cl.rznSocial }}</td>
                                <td width="40%"><strong>{{ cl.tipoDoc|catalog('06') }}:</strong> {{ cl.numDoc }}</td>
                            </tr>
                            <tr>
                                <td width="60%">
                                    <strong>Fecha Emisión:</strong> {{ doc.fechaEmision|date('d/m/Y') }}
                                    {% if doc.fechaEmision|date('H:i:s') != '00:00:00' %} {{ doc.fechaEmision|date('H:i:s') }} {% endif %}
                                    {% if doc.fecVencimiento is defined and doc.fecVencimiento %}
                                        <br><strong>Fecha Vencimiento:</strong> {{ doc.fecVencimiento|date('d/m/Y') }}
                                    {% endif %}
                                </td>
                                <td width="40%"><strong>Dirección:</strong> {% if cl.address %}{{ cl.address.direccion }}{% endif %}</td>
                            </tr>
                            <tr>
                                <td width="60%"><strong>Tipo Moneda:</strong> {{ doc.tipoMoneda|catalog('021') }}</td>
                                <td width="40%">{% if doc.compra is defined and doc.compra %}<strong>O/C:</strong> {{ doc.compra }}{% endif %}</td>
                            </tr>
                            {% if doc.guias %}
                            <tr>
                                <td colspan="2"><strong>Guías:</strong>
                                {% for guia in doc.guias %}{{ guia.nroDoc }}&nbsp;&nbsp;{% endfor %}
                                </td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                {% set moneda = doc.tipoMoneda|catalog('02') %}
                <table class="items" cellpadding="0" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Cantidad</th><th>Código</th><th>Descripción</th><th>Valor Unitario</th><th>Valor Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for det in doc.details %}
                        <tr>
                            <td align="center">{{ det.cantidad|n_format }} {{ det.unidad }}</td>
                            <td align="center">{{ det.codProducto }}</td>
                            <td>{{ det.descripcion }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorUnitario|n_format }}</td>
                            <td align="right">{{ moneda }} {{ det.mtoValorVenta|n_format }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;">
                    <tbody>
                        <tr>
                            <td width="55%" valign="top">
                                <div class="panel">
                                    <div class="panel-title">Información Adicional</div>
                                    <div style="font-size:10px;">
                                        <strong>LEYENDA:</strong> {{ legend(doc.legends, '1000') }}<br>
                                        {% if isInvoice and doc.detraccion %}
                                        <strong>TIPO DE DETRACCIÓN:</strong> {{ doc.detraccion.codBienDetraccion }} - {{ doc.detraccion.codBienDetraccion|catalog('54') }}<br>
                                        <strong>MEDIO DE PAGO:</strong> {{ doc.detraccion.codMedioPago }} - {{ doc.detraccion.codMedioPago|catalog('59') }}<br>
                                        <strong>N° CTA. BANCO NAC:</strong> {{ doc.detraccion.ctaBanco }}<br>
                                        {% endif %}
                                        {% if isNota %}
                                        <strong>MOTIVO DE EMISIÓN:</strong> {{ doc.desMotivo }}<br>
                                        {% endif %}
                                        {% if params.user.extras is defined %}
                                            {% for item in params.user.extras %}
                                            <strong>{{ item.name|upper }}:</strong> {{ item.value }}<br>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td width="45%" valign="top" style="padding-left:12px;">
                                <table width="100%" class="totals" cellpadding="0" cellspacing="0">
                                    <tbody>
                                        {% if doc.mtoOperGravadas %}
                                        <tr><td align="right">Op. Gravadas:</td><td align="right">{{ moneda }} {{ doc.mtoOperGravadas|n_format }}</td></tr>
                                        {% endif %}
                                        {% if doc.mtoOperExoneradas %}
                                        <tr><td align="right">Op. Exoneradas:</td><td align="right">{{ moneda }} {{ doc.mtoOperExoneradas|n_format }}</td></tr>
                                        {% endif %}
                                        <tr><td align="right">I.G.V.{% if params.user.numIGV is defined %} {{ params.user.numIGV }}%{% endif %}:</td><td align="right">{{ moneda }} {{ doc.mtoIGV|n_format }}</td></tr>
                                        <tr class="grand"><td align="right">Precio Venta:</td><td align="right"><span id="ride-importeTotal">{{ moneda }} {{ doc.mtoImpVenta|n_format }}</span></td></tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" class="footer-note">
                    <tbody>
                        <tr>
                            <td width="85%">
                                {% if params.user.footer is defined %}{{ params.user.footer|raw }}{% endif %}
                                {% if params.system.hash is defined and params.system.hash %}<br><strong>Resumen:</strong> {{ params.system.hash }}{% endif %}
                                <br>Representación Impresa de la FACTURA ELECTRÓNICA.
                            </td>
                            <td width="15%" align="right"><img src="{{ qrCode(doc)|image_b64('svg+xml') }}" alt="Qr Image" width="80"></td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </tbody>
</table>
</body>
</html>
